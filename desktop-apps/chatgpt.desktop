[Desktop Entry]
Name=ChatGPT www
GenericName=AI assistant
Comment=ChatGPT by OpenAI
# Force native Wayland: this build ignores --ozone-platform-hint and falls back
# to XWayland, where context menus become ARGB override-redirect windows that
# Hyprland blurs. Native xdg_popups avoid that (decoration:blur:popups = false).
Exec=chatgpt --ozone-platform=wayland --enable-features=WaylandWindowDecorations --enable-wayland-ime --wayland-text-input-version=3 %U
Icon=chatgpt
Type=Application
Terminal=false
StartupNotify=true
Categories=Utility;
