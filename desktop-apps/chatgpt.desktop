[Desktop Entry]
Name=ChatGPT w
GenericName=AI assistant
Comment=ChatGPT by OpenAI
# Native Wayland rendering and text-input-v3 integration for input methods.
Exec=chatgpt --enable-features=UseOzonePlatform,WaylandWindowDecorations --ozone-platform-hint=auto --wayland-text-input-version=3 %U
Icon=chatgpt
Type=Application
Terminal=false
StartupNotify=true
Categories=Utility;
